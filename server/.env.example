# 管住手了吗 · 自托管版配置
# 复制为 server/.env 后按需填写。不要把填好的 .env 提交到仓库。

# 服务端口
PORT=3000

# 运行环境：production 下不会返回演示数据
NODE_ENV=development

# 是否信任反代（部署在 nginx 之后设 1）
TRUST_PROXY=0

# OCR 来源：mock | textin | tencent | baidu | local
# mock 不连任何外部服务，只用于先看界面
OCR_PROVIDER=mock

# TextIn
TEXTIN_APP_ID=
TEXTIN_SECRET_CODE=

# 腾讯云 OCR
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_REGION=ap-shanghai

# 百度 OCR
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=

# 自建/本地 OCR 容器（local_ocr/）
LOCAL_OCR_URL=
LOCAL_OCR_TOKEN=

# 判定模式：off 只用规则引擎（默认，确定性）| on 允许用模型润色措辞
JUDGE_MODE=off

# 若启用措辞润色，任选一个模型供应商
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# K 线数据目录（把你自己的行情数据放这里，本仓不附带任何行情数据）
KLINE_ROOT=./public/data/kline
